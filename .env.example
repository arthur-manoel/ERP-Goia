# Copie para .env.local (nunca versionado) e preencha com as credenciais recebidas do time.
# Use MySQL: bancos locais são aceitos; no servidor remoto, somente joseev47_erp_dev.
# A URL é validada em prisma.config.ts e src/lib/prisma.ts.
DATABASE_URL="mysql://USUARIO:SENHA@HOST:3306/joseev47_erp_dev"

# Gere um segredo aleatório exclusivo para cada ambiente.
ACCESS_TOKEN_SECRET=""

DASHBOARD_DADOS_MOCK=true
# Sessão provisória de desenvolvimento (src/lib/sessao.ts), até a autenticação existir.
# Use ids de um usuário e de uma empresa que existam no banco.
DEV_ID_USUARIO=1
DEV_ID_EMPRESA=1
