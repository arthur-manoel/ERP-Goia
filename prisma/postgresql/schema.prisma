// Gerado de prisma/schema.prisma; não editar.
generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model administradores_gerais {
  id            Int                           @id @default(autoincrement())
  nome          String                        @db.VarChar(150)
  email         String                        @unique @db.VarChar(150)
  senha_hash    String                        @db.VarChar(255)
  status        administradores_gerais_status @default(ATIVO)
  data_cadastro DateTime                      @default(now()) @db.Timestamp(0)
}

model auditoria {
  id               Int            @id @default(autoincrement())
  id_empresa       Int?
  id_usuario       Int?
  tabela           String         @db.VarChar(100)
  id_registro      Int?
  acao             auditoria_acao
  dados_anteriores String?        @db.Text
  dados_novos      String?        @db.Text
  ip               String?        @db.VarChar(45)
  data_evento      DateTime       @default(now()) @db.Timestamp(0)
  empresas         empresas?      @relation(fields: [id_empresa], references: [id])
  usuarios         usuarios?      @relation(fields: [id_usuario], references: [id])

  @@index([id_empresa])
  @@index([id_usuario])
}

model cargos {
  id              Int               @id @default(autoincrement())
  id_empresa      Int
  nome            String            @db.VarChar(100)
  descricao       String?           @db.VarChar(255)
  status          cargos_status     @default(ATIVO)
  empresas        empresas          @relation(fields: [id_empresa], references: [id])
  usuario_empresa usuario_empresa[]

  @@unique([id_empresa, nome])
}

model categorias {
  id         Int               @id @default(autoincrement())
  id_empresa Int?
  nome       String            @db.VarChar(100)
  descricao  String?           @db.VarChar(255)
  status     categorias_status @default(ATIVA)
  empresas   empresas?         @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  produtos   produtos[]

  @@unique([id_empresa, nome])
}

model clientes {
  id                Int             @id @default(autoincrement())
  id_empresa        Int
  nome_razao_social String          @db.VarChar(150)
  cpf_cnpj          String?         @db.VarChar(20)
  email             String?         @db.VarChar(150)
  telefone          String?         @db.VarChar(30)
  endereco          String?         @db.VarChar(255)
  numero            String?         @db.VarChar(20)
  complemento       String?         @db.VarChar(100)
  bairro            String?         @db.VarChar(100)
  cidade            String?         @db.VarChar(100)
  estado            String?         @db.Char(2)
  cep               String?         @db.VarChar(10)
  status            clientes_status @default(ATIVO)
  data_cadastro     DateTime        @default(now()) @db.Timestamp(0)
  empresas          empresas        @relation(fields: [id_empresa], references: [id])
  venda             venda[]

  @@index([id_empresa])
}

model compra_itens {
  id             Int       @id @default(autoincrement())
  id_compra      Int
  id_produto     Int
  id_cor         Int?
  id_tamanho     Int?
  quantidade     Decimal   @db.Decimal(15, 3)
  valor_unitario Decimal   @default(0.00) @db.Decimal(15, 2)
  valor_total    Decimal   @default(0.00) @db.Decimal(15, 2)
  compras        compras   @relation(fields: [id_compra], references: [id], onDelete: Cascade)
  cores          cores?    @relation(fields: [id_cor], references: [id], onDelete: Restrict)
  produtos       produtos  @relation(fields: [id_produto], references: [id])
  tamanhos       tamanhos? @relation(fields: [id_tamanho], references: [id], onDelete: Restrict)

  @@unique([id_compra, id_produto, id_cor, id_tamanho])
  @@index([id_cor])
  @@index([id_produto])
  @@index([id_tamanho])
}

model compras {
  id                      Int             @id @default(autoincrement())
  id_empresa              Int
  id_local_estoque        Int
  id_fornecedor           Int
  id_ordem_producao       Int?
  id_usuario              Int
  id_pedido_compra_legado Int?            @unique
  codigo                  String          @db.VarChar(50)
  origem                  compras_origem  @default(MANUAL)
  status                  compras_status  @default(RASCUNHO)
  data_emissao            DateTime        @db.Timestamp(0)
  observacao              String?         @db.VarChar(255)
  data_cadastro           DateTime        @default(now()) @db.Timestamp(0)
  data_atualizacao        DateTime        @default(now()) @db.Timestamp(0)
  compra_itens            compra_itens[]
  empresas                empresas        @relation(fields: [id_empresa], references: [id])
  locais_estoque          locais_estoque  @relation(fields: [id_local_estoque], references: [id])
  fornecedores            fornecedores    @relation(fields: [id_fornecedor], references: [id])
  ordem_producao          ordem_producao? @relation(fields: [id_ordem_producao], references: [id])
  pedido_compra           pedido_compra?  @relation(fields: [id_pedido_compra_legado], references: [id])
  usuarios                usuarios        @relation(fields: [id_usuario], references: [id])
  nota_fiscal             nota_fiscal[]

  @@unique([id_empresa, codigo])
  @@index([id_local_estoque])
  @@index([id_fornecedor])
  @@index([id_ordem_producao])
  @@index([id_usuario])
  @@index([id_empresa, status])
}

model consumo_producao {
  id                      Int                  @id @default(autoincrement())
  id_ordem_producao       Int
  id_necessidade_producao Int
  id_reserva_estoque      Int
  id_produto              Int
  id_setor                Int
  quantidade              Decimal              @db.Decimal(15, 3)
  data_consumo            DateTime?            @db.Timestamp(0)
  id_usuario              Int
  necessidade_producao    necessidade_producao @relation(fields: [id_necessidade_producao], references: [id])
  ordem_producao          ordem_producao       @relation(fields: [id_ordem_producao], references: [id])
  produtos                produtos             @relation(fields: [id_produto], references: [id])
  reserva_estoque         reserva_estoque      @relation(fields: [id_reserva_estoque], references: [id])
  setores                 setores              @relation(fields: [id_setor], references: [id])
  usuarios                usuarios             @relation(fields: [id_usuario], references: [id])

  @@index([id_necessidade_producao])
  @@index([id_ordem_producao])
  @@index([id_produto])
  @@index([id_reserva_estoque])
  @@index([id_setor])
  @@index([id_usuario])
}

model cores {
  id                  Int                   @id @default(autoincrement())
  id_empresa          Int?
  nome                String                @db.VarChar(100)
  codigo_hex          String?               @db.VarChar(7)
  status              cores_status          @default(ATIVA)
  compra_itens        compra_itens[]
  empresas            empresas?             @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  item_nota_fiscal    item_nota_fiscal[]
  ordem_producao_item ordem_producao_item[]
  produto_empresa     produto_empresa[]
  produto_variacoes   produto_variacoes[]

  @@unique([id_empresa, nome])
}

model empresa_fornecedor {
  id              Int                       @id @default(autoincrement())
  id_empresa      Int
  id_fornecedor   Int
  prazo_pagamento Int?
  prazo_entrega   Int?
  observacao      String?                   @db.VarChar(255)
  status          empresa_fornecedor_status @default(ATIVO)
  empresas        empresas                  @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  fornecedores    fornecedores              @relation(fields: [id_fornecedor], references: [id])

  @@unique([id_empresa, id_fornecedor])
  @@index([id_fornecedor])
}

model empresas {
  id                     Int                      @id @default(autoincrement())
  razao_social           String                   @db.VarChar(150)
  nome_fantasia          String?                  @db.VarChar(150)
  cnpj                   String                   @unique @db.VarChar(18)
  inscricao_estadual     String?                  @db.VarChar(30)
  email                  String?                  @db.VarChar(150)
  telefone               String?                  @db.VarChar(30)
  endereco               String?                  @db.VarChar(255)
  numero                 String?                  @db.VarChar(20)
  complemento            String?                  @db.VarChar(100)
  bairro                 String?                  @db.VarChar(100)
  cidade                 String?                  @db.VarChar(100)
  estado                 String?                  @db.Char(2)
  cep                    String?                  @db.VarChar(10)
  logo_url               String?                  @db.Text
  cor_tema               String                   @default("#22c55e") @db.VarChar(50)
  status                 empresas_status          @default(ATIVA)
  data_cadastro          DateTime                 @default(now()) @db.Timestamp(0)
  auditoria              auditoria[]
  cargos                 cargos[]
  categorias             categorias[]
  clientes               clientes[]
  compras                compras[]
  cores                  cores[]
  empresa_fornecedor     empresa_fornecedor[]
  estoque                estoque[]
  ficha_tecnica          ficha_tecnica[]
  fornecedores           fornecedores[]
  kardex                 kardex[]
  locais_estoque         locais_estoque[]
  movimentacao_estoque   movimentacao_estoque[]
  nota_fiscal            nota_fiscal[]
  ordem_producao         ordem_producao[]
  pedido_compra          pedido_compra[]
  produto_empresa        produto_empresa[]
  produto_fornecedor     produto_fornecedor[]
  produto_variacoes      produto_variacoes[]
  requisicao_compra      requisicao_compra[]
  reserva_estoque        reserva_estoque[]
  sequencias_automaticas sequencias_automaticas[]
  setores                setores[]
  tamanhos               tamanhos[]
  tipos_setor            tipos_setor[]
  usuario_empresa        usuario_empresa[]
  venda                  venda[]
}

model estoque {
  id                   Int            @id @default(autoincrement())
  id_empresa           Int
  id_local_estoque     Int
  id_setor             Int
  id_produto           Int
  quantidade           Decimal        @default(0.000) @db.Decimal(15, 3)
  quantidade_reservada Decimal        @default(0.000) @db.Decimal(15, 3)
  data_atualizacao     DateTime       @default(now()) @db.Timestamp(0)
  empresas             empresas       @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  locais_estoque       locais_estoque @relation(fields: [id_local_estoque], references: [id])
  produtos             produtos       @relation(fields: [id_produto], references: [id])
  setores              setores        @relation(fields: [id_setor], references: [id])

  @@unique([id_empresa, id_local_estoque, id_produto])
  @@unique([id_empresa, id_setor, id_produto])
  @@index([id_local_estoque])
  @@index([id_produto])
  @@index([id_setor])
}

model ficha_tecnica {
  id                 Int                  @id @default(autoincrement())
  id_empresa         Int
  id_produto         Int
  versao             Int                  @default(1)
  status             ficha_tecnica_status @default(RASCUNHO)
  data_vigencia      DateTime?            @db.Date
  empresas           empresas             @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  produtos           produtos             @relation(fields: [id_produto], references: [id])
  ficha_tecnica_item ficha_tecnica_item[]

  @@unique([id_empresa, id_produto, versao])
  @@index([id_produto])
}

model ficha_tecnica_item {
  id                    Int           @id @default(autoincrement())
  id_ficha_tecnica      Int
  id_produto_componente Int
  quantidade            Decimal       @db.Decimal(15, 3)
  perda_percentual      Decimal       @default(0.00) @db.Decimal(5, 2)
  produtos              produtos      @relation(fields: [id_produto_componente], references: [id])
  ficha_tecnica         ficha_tecnica @relation(fields: [id_ficha_tecnica], references: [id], onDelete: Cascade)

  @@unique([id_ficha_tecnica, id_produto_componente])
  @@index([id_produto_componente])
}

model fornecedores {
  id                 Int                  @id @default(autoincrement())
  id_empresa         Int?
  razao_social       String               @db.VarChar(150)
  nome_fantasia      String?              @db.VarChar(150)
  cnpj               String?              @db.VarChar(18)
  inscricao_estadual String?              @db.VarChar(30)
  email              String?              @db.VarChar(150)
  telefone           String?              @db.VarChar(30)
  endereco           String?              @db.VarChar(255)
  numero             String?              @db.VarChar(20)
  complemento        String?              @db.VarChar(100)
  bairro             String?              @db.VarChar(100)
  cidade             String?              @db.VarChar(100)
  estado             String?              @db.Char(2)
  cep                String?              @db.VarChar(10)
  status             fornecedores_status  @default(ATIVO)
  data_cadastro      DateTime             @default(now()) @db.Timestamp(0)
  compras            compras[]
  empresa_fornecedor empresa_fornecedor[]
  empresas           empresas?            @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  nota_fiscal        nota_fiscal[]
  pedido_compra      pedido_compra[]
  produto_fornecedor produto_fornecedor[]

  @@unique([id_empresa, cnpj])
}

model item_nota_fiscal {
  id                                 Int                         @id @default(autoincrement())
  id_nota_fiscal                     Int
  numero_item                        Int
  id_produto                         Int?
  id_cor                             Int?
  id_tamanho                         Int?
  codigo_produto                     String?                     @db.VarChar(100)
  descricao_produto                  String?                     @db.VarChar(255)
  quantidade                         Decimal                     @db.Decimal(15, 3)
  unidade                            String                      @db.VarChar(20)
  tipo_valor                         item_nota_fiscal_tipo_valor @default(UNITARIO)
  valor_unitario                     Decimal                     @db.Decimal(15, 2)
  valor_total                        Decimal                     @db.Decimal(15, 2)
  produto_cadastrado_automaticamente Boolean                     @default(false)
  cores                              cores?                      @relation(fields: [id_cor], references: [id], onDelete: Restrict)
  nota_fiscal                        nota_fiscal                 @relation(fields: [id_nota_fiscal], references: [id], onDelete: Cascade)
  produtos                           produtos?                   @relation(fields: [id_produto], references: [id], onDelete: Restrict)
  tamanhos                           tamanhos?                   @relation(fields: [id_tamanho], references: [id], onDelete: Restrict)

  @@unique([id_nota_fiscal, numero_item])
  @@index([id_cor])
  @@index([id_produto])
  @@index([id_tamanho])
}

model item_pedido_compra {
  id               Int           @id @default(autoincrement())
  id_pedido_compra Int
  id_produto       Int
  quantidade       Decimal       @db.Decimal(15, 3)
  valor_unitario   Decimal       @db.Decimal(15, 2)
  valor_total      Decimal       @db.Decimal(15, 2)
  pedido_compra    pedido_compra @relation(fields: [id_pedido_compra], references: [id], onDelete: Cascade)
  produtos         produtos      @relation(fields: [id_produto], references: [id])

  @@index([id_pedido_compra])
  @@index([id_produto])
}

model item_requisicao_compra {
  id                   Int               @id @default(autoincrement())
  id_requisicao_compra Int
  id_produto           Int
  quantidade           Decimal           @db.Decimal(15, 3)
  observacao           String?           @db.VarChar(255)
  produtos             produtos          @relation(fields: [id_produto], references: [id])
  requisicao_compra    requisicao_compra @relation(fields: [id_requisicao_compra], references: [id], onDelete: Cascade)

  @@unique([id_requisicao_compra, id_produto])
  @@index([id_produto])
}

model item_venda {
  id             Int      @id @default(autoincrement())
  id_venda       Int
  id_produto     Int
  quantidade     Decimal  @db.Decimal(15, 3)
  valor_unitario Decimal  @db.Decimal(15, 2)
  valor_total    Decimal  @db.Decimal(15, 2)
  produtos       produtos @relation(fields: [id_produto], references: [id])
  venda          venda    @relation(fields: [id_venda], references: [id], onDelete: Cascade)

  @@unique([id_venda, id_produto])
  @@index([id_produto])
}

model kardex {
  id                   Int                      @id @default(autoincrement())
  id_empresa           Int
  id_local_estoque     Int?
  id_setor             Int?
  id_produto           Int
  id_movimentacao      Int                      @unique
  tipo_movimentacao    kardex_tipo_movimentacao
  quantidade           Decimal                  @db.Decimal(15, 3)
  saldo_anterior       Decimal                  @db.Decimal(15, 3)
  saldo_atual          Decimal                  @db.Decimal(15, 3)
  data_movimentacao    DateTime                 @default(now()) @db.Timestamp(0)
  empresas             empresas                 @relation(fields: [id_empresa], references: [id])
  locais_estoque       locais_estoque?          @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict)
  movimentacao_estoque movimentacao_estoque     @relation(fields: [id_movimentacao], references: [id])
  produtos             produtos                 @relation(fields: [id_produto], references: [id])
  setores              setores?                 @relation(fields: [id_setor], references: [id], onDelete: Restrict)

  @@index([id_empresa])
  @@index([id_local_estoque])
  @@index([id_produto])
  @@index([id_setor])
}

model locais_estoque {
  id                   Int                    @id @default(autoincrement())
  id_empresa           Int
  nome                 String                 @db.VarChar(100)
  descricao            String?                @db.VarChar(255)
  status               locais_estoque_status  @default(ATIVO)
  compras              compras[]
  estoque              estoque[]
  kardex               kardex[]
  empresas             empresas               @relation(fields: [id_empresa], references: [id], onDelete: Cascade)
  movimentacao_estoque movimentacao_estoque[]
  nota_fiscal          nota_fiscal[]
  ordem_producao       ordem_producao[]
  requisicao_compra    requisicao_compra[]
  reserva_estoque      reserva_estoque[]

  @@unique([id_empresa, nome])
}

model movimentacao_estoque {
  id                Int                       @id @default(autoincrement())
  id_empresa        Int
  id_local_estoque  Int?
  id_setor          Int?
  id_produto        Int
  tipo              movimentacao_estoque_tipo
  quantidade        Decimal                   @db.Decimal(15, 3)
  valor_total       Decimal                   @default(0.00) @db.Decimal(15, 2)
  origem_tipo       String?                   @db.VarChar(50)
  origem_id         Int?
  id_usuario        Int
  data_movimentacao DateTime                  @default(now()) @db.Timestamp(0)
  observacao        String?                   @db.VarChar(255)
  kardex            kardex?
  empresas          empresas                  @relation(fields: [id_empresa], references: [id])
  locais_estoque    locais_estoque?           @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict)
  produtos          produtos                  @relation(fields: [id_produto], references: [id])
  setores           setores?                  @relation(fields: [id_setor], references: [id], onDelete: Restrict)
  usuarios          usuarios                  @relation(fields: [id_usuario], references: [id])

  @@index([id_empresa])
  @@index([id_local_estoque])
  @@index([id_produto])
  @@index([id_setor])
  @@index([id_usuario])
}

model necessidade_producao {
  id                    Int                         @id @default(autoincrement())
  id_ordem_producao     Int
  id_produto            Int
  quantidade_necessaria Decimal                     @db.Decimal(15, 3)
  quantidade_reservada  Decimal                     @default(0.000) @db.Decimal(15, 3)
  quantidade_consumida  Decimal                     @default(0.000) @db.Decimal(15, 3)
  status                necessidade_producao_status @default(PENDENTE)
  consumo_producao      consumo_producao[]
  ordem_producao        ordem_producao              @relation(fields: [id_ordem_producao], references: [id], onDelete: Cascade)
  produtos              produtos                    @relation(fields: [id_produto], references: [id])
  reserva_estoque       reserva_estoque[]

  @@unique([id_ordem_producao, id_produto])
  @@index([id_produto])
}

model nota_fiscal {
  id                 Int                @id @default(autoincrement())
  id_empresa         Int
  id_local_estoque   Int?
  id_fornecedor      Int
  id_pedido_compra   Int?
  id_compra          Int?
  id_setor_destino   Int?
  numero             String             @db.VarChar(30)
  serie              String             @db.VarChar(10)
  chave_acesso       String             @unique @db.VarChar(44)
  status             nota_fiscal_status @default(PENDENTE)
  data_emissao       DateTime?          @db.Timestamp(0)
  data_recebimento   DateTime?          @db.Timestamp(0)
  valor_total        Decimal            @default(0.00) @db.Decimal(15, 2)
  entrada_processada Boolean            @default(false)
  data_processamento DateTime?          @db.Timestamp(0)
  observacao         String?            @db.VarChar(255)
  item_nota_fiscal   item_nota_fiscal[]
  setores            setores?           @relation(fields: [id_setor_destino], references: [id], onDelete: Restrict)
  compras            compras?           @relation(fields: [id_compra], references: [id], onDelete: Restrict)
  empresas           empresas           @relation(fields: [id_empresa], references: [id])
  fornecedores       fornecedores       @relation(fields: [id_fornecedor], references: [id])
  locais_estoque     locais_estoque?    @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict)
  pedido_compra      pedido_compra?     @relation(fields: [id_pedido_compra], references: [id])

  @@unique([id_empresa, numero, serie])
  @@index([id_setor_destino])
  @@index([id_compra])
  @@index([id_fornecedor])
  @@index([id_local_estoque])
  @@index([id_pedido_compra])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ordem_producao {
  id                                Int                                 @id @default(autoincrement())
  id_empresa                        Int
  id_local_estoque                  Int?
  id_usuario                        Int
  id_setor                          Int?
  numero                            String                              @db.VarChar(50)
  prioridade                        ordem_producao_prioridade           @default(NORMAL)
  quantidade_planejada              Decimal                             @default(0.000) @db.Decimal(15, 3)
  status                            ordem_producao_status               @default(PLANEJADA)
  data_inicio                       DateTime?                           @db.Timestamp(0)
  data_previsao                     DateTime?                           @db.Timestamp(0)
  data_conclusao                    DateTime?                           @db.Timestamp(0)
  observacao                        String?                             @db.VarChar(255)
  compras                           compras[]
  consumo_producao                  consumo_producao[]
  necessidade_producao              necessidade_producao[]
  setores                           setores?                            @relation(fields: [id_setor], references: [id], onDelete: Restrict)
  empresas                          empresas                            @relation(fields: [id_empresa], references: [id])
  locais_estoque                    locais_estoque?                     @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict)
  usuarios                          usuarios                            @relation(fields: [id_usuario], references: [id])
  ordem_producao_consumo_planejado  ordem_producao_consumo_planejado[]
  ordem_producao_fluxo_setor        ordem_producao_fluxo_setor[]
