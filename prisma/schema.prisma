  @@unique([id_empresa, nome], map: "uk_local_estoque_empresa_nome")
}

model movimentacao_estoque {
  id                Int                       @id @default(autoincrement())
  id_empresa        Int
  id_local_estoque  Int?
  id_setor          Int?
  id_produto        Int
  tipo              movimentacao_estoque_tipo
  quantidade        Decimal                   @db.Decimal(15, 3)
  valor_total       Decimal                   @default(0.00) @db.Decimal(15, 2)
  origem_tipo       String?                   @db.VarChar(50)
  origem_id         Int?
  id_usuario        Int
  data_movimentacao DateTime                  @default(now()) @db.Timestamp(0)
  observacao        String?                   @db.VarChar(255)
  kardex            kardex?
  empresas          empresas                  @relation(fields: [id_empresa], references: [id], map: "fk_mov_estoque_empresa")
  locais_estoque    locais_estoque?           @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict, map: "fk_mov_estoque_local")
  produtos          produtos                  @relation(fields: [id_produto], references: [id], map: "fk_mov_estoque_produto")
  setores           setores?                  @relation(fields: [id_setor], references: [id], onDelete: Restrict, map: "fk_mov_estoque_setor")
  usuarios          usuarios                  @relation(fields: [id_usuario], references: [id], map: "fk_mov_estoque_usuario")

  @@index([id_empresa], map: "fk_mov_estoque_empresa")
  @@index([id_local_estoque], map: "fk_mov_estoque_local")
  @@index([id_produto], map: "fk_mov_estoque_produto")
  @@index([id_setor], map: "fk_mov_estoque_setor")
  @@index([id_usuario], map: "fk_mov_estoque_usuario")
}

model movimentacoes_financeiras {
  id                   Int                              @id @default(autoincrement())
  id_empresa           Int
  id_conta_bancaria    Int
