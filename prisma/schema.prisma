  empresas             empresas                         @relation(fields: [id_empresa], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contas_bancarias     contas_bancarias                 @relation(fields: [id_conta_bancaria], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pagamentos_receber   pagamentos_receber?              @relation(fields: [id_pagamento_receber], references: [id], onDelete: SetNull, onUpdate: Cascade)
