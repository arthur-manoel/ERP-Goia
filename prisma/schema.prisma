  status                  fluxos_producao_status    @default(ATIVO)
  data_cadastro           DateTime                  @default(now()) @db.DateTime(3)
  data_atualizacao        DateTime                  @default(now()) @updatedAt @db.DateTime(3)
  empresas                empresas                  @relation(fields: [id_empresa], references: [id], onDelete: Cascade, map: "fk_fluxo_empresa")
  fluxo_producao_setor    fluxo_producao_setor[]
  produto_fluxo           produto_fluxo[]
  ordem_producao_snapshot ordem_producao_snapshot[]

