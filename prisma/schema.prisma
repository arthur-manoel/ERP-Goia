  id_local_estoque       Int?
  id_setor_solicitante   Int?
  id_usuario_solicitante Int
  numero                 String                   @db.VarChar(50)
  status                 requisicao_compra_status @default(RASCUNHO)
  data_solicitacao       DateTime                 @default(now()) @db.Timestamp(0)
