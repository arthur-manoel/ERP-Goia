model reserva_estoque {
  id                      Int                         @id @default(autoincrement())
  id_empresa              Int
  id_local_estoque        Int?
  id_setor                Int?
  id_produto              Int
  tipo_origem             reserva_estoque_tipo_origem
  id_venda                Int?
  id_ordem_producao       Int?
  id_necessidade_producao Int?
  quantidade              Decimal                     @db.Decimal(15, 3)
  status                  reserva_estoque_status      @default(ATIVA)
  id_usuario              Int
  data_reserva            DateTime                    @default(now()) @db.Timestamp(0)
  data_finalizacao        DateTime?                   @db.DateTime(0)
  consumo_producao        consumo_producao[]
  empresas                empresas                    @relation(fields: [id_empresa], references: [id], map: "fk_reserva_empresa")
  locais_estoque          locais_estoque?             @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict, map: "fk_reserva_estoque_local")
  necessidade_producao    necessidade_producao?       @relation(fields: [id_necessidade_producao], references: [id], map: "fk_reserva_necessidade")
  ordem_producao          ordem_producao?             @relation(fields: [id_ordem_producao], references: [id], map: "fk_reserva_ordem")
  produtos                produtos                    @relation(fields: [id_produto], references: [id], map: "fk_reserva_produto")
  setores                 setores?                    @relation(fields: [id_setor], references: [id], onDelete: Restrict, map: "fk_reserva_setor")
  usuarios                usuarios                    @relation(fields: [id_usuario], references: [id], map: "fk_reserva_usuario")
  venda                   venda?                      @relation(fields: [id_venda], references: [id], map: "fk_reserva_venda")

  @@index([id_empresa], map: "fk_reserva_empresa")
  @@index([id_local_estoque], map: "fk_reserva_estoque_local")
  @@index([id_necessidade_producao], map: "fk_reserva_necessidade")
  @@index([id_ordem_producao], map: "fk_reserva_ordem")
  @@index([id_produto], map: "fk_reserva_produto")
  @@index([id_setor], map: "fk_reserva_setor")
  @@index([id_usuario], map: "fk_reserva_usuario")
  @@index([id_venda], map: "fk_reserva_venda")
}

