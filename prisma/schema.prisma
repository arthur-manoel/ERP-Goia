generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model administradores_gerais {
  id            Int                           @id @default(autoincrement())
  nome          String                        @db.VarChar(150)
  email         String                        @unique(map: "uk_administrador_geral_email") @db.VarChar(150)
  senha_hash    String                        @db.VarChar(255)
  status        administradores_gerais_status @default(ATIVO)
  data_cadastro DateTime                      @default(now()) @db.Timestamp(0)
}

model auditoria {
  id               Int            @id @default(autoincrement())
  id_empresa       Int?
  id_usuario       Int?
  tabela           String         @db.VarChar(100)
  id_registro      Int?
  acao             auditoria_acao
  dados_anteriores String?        @db.Text
  dados_novos      String?        @db.Text
  ip               String?        @db.VarChar(45)
  data_evento      DateTime       @default(now()) @db.Timestamp(0)
  empresas         empresas?      @relation(fields: [id_empresa], references: [id], map: "fk_auditoria_empresa")
  usuarios         usuarios?      @relation(fields: [id_usuario], references: [id], map: "fk_auditoria_usuario")

  @@index([id_empresa], map: "fk_auditoria_empresa")
  @@index([id_usuario], map: "fk_auditoria_usuario")
}

model cargos {
  id              Int               @id @default(autoincrement())
  id_empresa      Int
  nome            String            @db.VarChar(100)
  descricao       String?           @db.VarChar(255)
  status          cargos_status     @default(ATIVO)
  empresas        empresas          @relation(fields: [id_empresa], references: [id], map: "fk_cargos_empresa")
  usuario_empresa usuario_empresa[]

  @@unique([id_empresa, nome], map: "uk_cargo_empresa_nome")
}

model categoria_financeira {
  id             Int                         @id @default(autoincrement())
  id_empresa     Int
  nome           String                      @db.VarChar(100)
  tipo           categoria_financeira_tipo   @default(AMBOS)
  descricao      String?                     @db.VarChar(255)
  status         categoria_financeira_status @default(ATIVA)
  data_cadastro  DateTime                    @default(now())
  empresas       empresas                    @relation(fields: [id_empresa], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contas_receber contas_receber[]
  contas_pagar   contas_pagar[]
  despesas       despesas[]

  @@unique([id_empresa, nome], map: "uk_categoria_financeira_empresa_nome")
  @@index([id_empresa], map: "idx_categoria_financeira_empresa")
}

model categorias {
  id         Int               @id @default(autoincrement())
  id_empresa Int?
  nome       String            @db.VarChar(100)
  descricao  String?           @db.VarChar(255)
  status     categorias_status @default(ATIVA)
  empresas   empresas?         @relation(fields: [id_empresa], references: [id], onDelete: Cascade, map: "fk_categorias_empresa")
  produtos   produtos[]

  @@unique([id_empresa, nome], map: "uk_categoria_empresa_nome")
}

model cliente_contato {
  id            Int      @id @default(autoincrement())
  id_cliente    Int
  tipo          String   @db.VarChar(30)
  valor         String   @db.VarChar(150)
  descricao     String?  @db.VarChar(100)
  principal     Boolean  @default(false)
  ativo         Boolean  @default(true)
  data_cadastro DateTime @default(now())
  clientes      clientes @relation(fields: [id_cliente], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_cliente], map: "idx_cliente_contato_cliente")
}

model cliente_endereco {
  id            Int                   @id @default(autoincrement())
  id_cliente    Int
  tipo          cliente_endereco_tipo @default(PRINCIPAL)
  descricao     String?               @db.VarChar(100)
  endereco      String                @db.VarChar(255)
  numero        String?               @db.VarChar(20)
  complemento   String?               @db.VarChar(100)
  bairro        String?               @db.VarChar(100)
  cidade        String?               @db.VarChar(100)
  estado        String?               @db.Char(2)
  cep           String?               @db.VarChar(10)
  referencia    String?               @db.VarChar(255)
  principal     Boolean               @default(false)
  ativo         Boolean               @default(true)
  data_cadastro DateTime              @default(now())
  clientes      clientes              @relation(fields: [id_cliente], references: [id], onDelete: Cascade, onUpdate: Cascade)
  venda         venda[]               @relation("VendaEnderecoEntrega")

  pedido_cliente pedido_cliente[]

  @@index([id_cliente], map: "idx_cliente_endereco_cliente")
  @@index([id_cliente, tipo], map: "idx_cliente_endereco_tipo")
}

model clientes {
  id                    Int                  @id @default(autoincrement())
  id_empresa            Int
  nome_razao_social     String               @db.VarChar(150)
  cpf_cnpj              String?              @db.VarChar(20)
  email                 String?              @db.VarChar(150)
  telefone              String?              @db.VarChar(30)
  endereco              String?              @db.VarChar(255)
  numero                String?              @db.VarChar(20)
  complemento           String?              @db.VarChar(100)
  bairro                String?              @db.VarChar(100)
  cidade                String?              @db.VarChar(100)
  estado                String?              @db.Char(2)
  cep                   String?              @db.VarChar(10)
  status                clientes_status      @default(ATIVO)
  data_cadastro         DateTime             @default(now()) @db.Timestamp(0)
  tipo_pessoa           clientes_tipo_pessoa @default(FISICA)
  nome_fantasia         String?              @db.VarChar(150)
  inscricao_estadual    String?              @db.VarChar(30)
  limite_credito        Decimal              @default(0) @db.Decimal(15, 2)
  observacao            String?              @db.Text
  id_condicao_pagamento Int?
  data_atualizacao      DateTime             @updatedAt
  empresas              empresas             @relation(fields: [id_empresa], references: [id], map: "fk_clientes_empresa")
  venda                 venda[]
  condicoes_pagamento   condicoes_pagamento? @relation(fields: [id_condicao_pagamento], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cliente_endereco      cliente_endereco[]
  cliente_contato       cliente_contato[]

  pedido_cliente pedido_cliente[]

  @@index([id_empresa], map: "idx_cliente_empresa")
  @@index([id_condicao_pagamento])
}

model compra_itens {
  id             Int       @id @default(autoincrement())
  id_compra      Int
  id_produto     Int
  id_cor         Int?
  id_tamanho     Int?
  quantidade     Decimal   @db.Decimal(15, 3)
  valor_unitario Decimal   @default(0.00) @db.Decimal(15, 2)
  valor_total    Decimal   @default(0.00) @db.Decimal(15, 2)
  compras        compras   @relation(fields: [id_compra], references: [id], onDelete: Cascade, map: "fk_compra_item_compra")
  cores          cores?    @relation(fields: [id_cor], references: [id], onDelete: Restrict, map: "fk_compra_item_cor")
  produtos       produtos  @relation(fields: [id_produto], references: [id], map: "fk_compra_item_produto")
  tamanhos       tamanhos? @relation(fields: [id_tamanho], references: [id], onDelete: Restrict, map: "fk_compra_item_tamanho")

  @@unique([id_compra, id_produto, id_cor, id_tamanho], map: "uk_compra_item_produto_variacao")
  @@index([id_cor], map: "fk_compra_item_cor")
  @@index([id_produto], map: "fk_compra_item_produto")
  @@index([id_tamanho], map: "fk_compra_item_tamanho")
}

model compras {
  id                      Int             @id @default(autoincrement())
  id_empresa              Int
  id_local_estoque        Int
  id_fornecedor           Int
  id_ordem_producao       Int?
  id_usuario              Int
  id_pedido_compra_legado Int?            @unique(map: "uk_compra_pedido_legado")
  codigo                  String          @db.VarChar(50)
  origem                  compras_origem  @default(MANUAL)
  status                  compras_status  @default(RASCUNHO)
  data_emissao            DateTime        @db.DateTime(0)
  observacao              String?         @db.VarChar(255)
  data_cadastro           DateTime        @default(now()) @db.Timestamp(0)
  data_atualizacao        DateTime        @default(now()) @db.Timestamp(0)
  compra_itens            compra_itens[]
  empresas                empresas        @relation(fields: [id_empresa], references: [id], map: "fk_compra_empresa")
  locais_estoque          locais_estoque  @relation(fields: [id_local_estoque], references: [id], map: "fk_compra_estoque")
  fornecedores            fornecedores    @relation(fields: [id_fornecedor], references: [id], map: "fk_compra_fornecedor")
  ordem_producao          ordem_producao? @relation(fields: [id_ordem_producao], references: [id], map: "fk_compra_op")
  pedido_compra           pedido_compra?  @relation(fields: [id_pedido_compra_legado], references: [id], map: "fk_compra_pedido_legado")
  usuarios                usuarios        @relation(fields: [id_usuario], references: [id], map: "fk_compra_usuario")
  nota_fiscal             nota_fiscal[]
  contas_pagar            contas_pagar[]

  @@unique([id_empresa, codigo], map: "uk_compra_empresa_codigo")
  @@index([id_local_estoque], map: "fk_compra_estoque")
  @@index([id_fornecedor], map: "fk_compra_fornecedor")
  @@index([id_ordem_producao], map: "fk_compra_op")
  @@index([id_usuario], map: "fk_compra_usuario")
  @@index([id_empresa, status], map: "idx_compra_empresa_status")
}

model condicoes_pagamento {
  id                   Int                        @id @default(autoincrement())
  id_empresa           Int
  nome                 String                     @db.VarChar(100)
  descricao            String?                    @db.VarChar(255)
  numero_parcelas      Int                        @default(1)
  intervalo_dias       Int                        @default(0)
  permite_parcelamento Boolean                    @default(false)
  permite_credito      Boolean                    @default(false)
  desconto_percentual  Decimal                    @default(0) @db.Decimal(5, 2)
  status               condicoes_pagamento_status @default(ATIVA)
  data_cadastro        DateTime                   @default(now())
  empresas             empresas                   @relation(fields: [id_empresa], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clientes             clientes[]
  venda                venda[]

  pedido_cliente pedido_cliente[]

  @@unique([id_empresa, nome], map: "uk_condicao_pagamento_empresa_nome")
  @@index([id_empresa], map: "idx_condicao_pagamento_empresa")
}

model consumo_producao {
  id                      Int                  @id @default(autoincrement())
  id_ordem_producao       Int
  id_necessidade_producao Int
  id_reserva_estoque      Int
  id_produto              Int
  id_setor                Int
  quantidade              Decimal              @db.Decimal(15, 3)
  data_consumo            DateTime?            @db.DateTime(0)
  id_usuario              Int
  necessidade_producao    necessidade_producao @relation(fields: [id_necessidade_producao], references: [id], map: "fk_consumo_necessidade")
  ordem_producao          ordem_producao       @relation(fields: [id_ordem_producao], references: [id], map: "fk_consumo_op")
  produtos                produtos             @relation(fields: [id_produto], references: [id], map: "fk_consumo_produto")
  reserva_estoque         reserva_estoque      @relation(fields: [id_reserva_estoque], references: [id], map: "fk_consumo_reserva")
  setores                 setores              @relation(fields: [id_setor], references: [id], map: "fk_consumo_setor")
  usuarios                usuarios             @relation(fields: [id_usuario], references: [id], map: "fk_consumo_usuario")

  @@index([id_necessidade_producao], map: "fk_consumo_necessidade")
  @@index([id_ordem_producao], map: "fk_consumo_op")
  @@index([id_produto], map: "fk_consumo_produto")
  @@index([id_reserva_estoque], map: "fk_consumo_reserva")
  @@index([id_setor], map: "fk_consumo_setor")
  @@index([id_usuario], map: "fk_consumo_usuario")
}

model contas_bancarias {
  id                        Int                         @id @default(autoincrement())
  id_empresa                Int
  nome                      String                      @db.VarChar(100)
  banco                     String?                     @db.VarChar(100)
  agencia                   String?                     @db.VarChar(20)
  numero_conta              String?                     @db.VarChar(30)
  tipo                      contas_bancarias_tipo
  saldo_inicial             Decimal                     @default(0) @db.Decimal(15, 2)
  status                    contas_bancarias_status     @default(ATIVA)
  data_cadastro             DateTime                    @default(now())
  empresas                  empresas                    @relation(fields: [id_empresa], references: [id], onDelete: Cascade, onUpdate: Cascade)
  movimentacoes_financeiras movimentacoes_financeiras[]

  @@unique([id_empresa, nome], map: "uk_conta_bancaria_empresa_nome")
  @@index([id_empresa], map: "idx_conta_bancaria_empresa")
}

model contas_pagar {
  id                   Int                         @id @default(autoincrement())
  id_empresa           Int
  id_compra            Int
  id_categoria         Int
  numero_parcela       Int                         @default(1)
  total_parcelas       Int                         @default(1)
  descricao            String?                     @db.VarChar(255)
  data_lancamento      DateTime                    @default(now())
  data_vencimento      DateTime                    @db.Date
  valor_original       Decimal                     @db.Decimal(15, 2)
  valor_desconto       Decimal                     @default(0) @db.Decimal(15, 2)
  valor_acrescimo      Decimal                     @default(0) @db.Decimal(15, 2)
  valor_final          Decimal                     @db.Decimal(15, 2)
  situacao             contas_financeiras_situacao @default(ABERTO)
  observacao           String?                     @db.Text
  data_cadastro        DateTime                    @default(now())
  data_atualizacao     DateTime                    @updatedAt
  empresas             empresas                    @relation(fields: [id_empresa], references: [id], onDelete: Restrict, onUpdate: Cascade)
  compras              compras                     @relation(fields: [id_compra], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoria_financeira categoria_financeira        @relation(fields: [id_categoria], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pagamentos_pagar     pagamentos_pagar[]
  despesas             despesas[]

  @@index([id_empresa], map: "idx_contas_pagar_empresa")
  @@index([id_compra], map: "idx_contas_pagar_compra")
  @@index([id_categoria], map: "idx_contas_pagar_categoria")
  @@index([data_vencimento], map: "idx_contas_pagar_vencimento")
  @@index([situacao], map: "idx_contas_pagar_situacao")
}

model contas_receber {
  id                   Int                         @id @default(autoincrement())
  id_empresa           Int
  id_venda             Int
  id_categoria         Int
  numero_parcela       Int                         @default(1)
  total_parcelas       Int                         @default(1)
  descricao            String?                     @db.VarChar(255)
  data_lancamento      DateTime                    @default(now())
  data_vencimento      DateTime                    @db.Date
  valor_original       Decimal                     @db.Decimal(15, 2)
  valor_desconto       Decimal                     @default(0) @db.Decimal(15, 2)
  valor_acrescimo      Decimal                     @default(0) @db.Decimal(15, 2)
  valor_final          Decimal                     @db.Decimal(15, 2)
  situacao             contas_financeiras_situacao @default(ABERTO)
  observacao           String?                     @db.Text
  data_cadastro        DateTime                    @default(now())
  data_atualizacao     DateTime                    @updatedAt
  empresas             empresas                    @relation(fields: [id_empresa], references: [id], onDelete: Restrict, onUpdate: Cascade)
  venda                venda                       @relation(fields: [id_venda], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoria_financeira categoria_financeira        @relation(fields: [id_categoria], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pagamentos_receber   pagamentos_receber[]

  @@index([id_empresa], map: "idx_contas_receber_empresa")
  @@index([id_venda], map: "idx_contas_receber_venda")
  @@index([id_categoria], map: "idx_contas_receber_categoria")
  @@index([data_vencimento], map: "idx_contas_receber_vencimento")
  @@index([situacao], map: "idx_contas_receber_situacao")
}

model cores {
  id                  Int                   @id @default(autoincrement())
  id_empresa          Int?
  nome                String                @db.VarChar(100)
  codigo_hex          String?               @db.VarChar(7)
  status              cores_status          @default(ATIVA)
  compra_itens        compra_itens[]
  empresas            empresas?             @relation(fields: [id_empresa], references: [id], onDelete: Cascade, map: "fk_cores_empresa")
  item_nota_fiscal    item_nota_fiscal[]
  ordem_producao_item ordem_producao_item[]
  produto_empresa     produto_empresa[]
  produto_variacoes   produto_variacoes[]

  pedido_cliente_item pedido_cliente_item[]

  @@unique([id_empresa, nome], map: "uk_cor_empresa_nome")
}

model despesas {
  id                        Int                         @id @default(autoincrement())
  id_empresa                Int
  id_categoria              Int
  id_conta_pagar            Int?
  descricao                 String                      @db.VarChar(255)
  data_despesa              DateTime                    @db.Date
  valor                     Decimal                     @db.Decimal(15, 2)
  situacao                  despesas_situacao           @default(ABERTA)
  observacao                String?                     @db.Text
  data_cadastro             DateTime                    @default(now())
  data_atualizacao          DateTime                    @updatedAt
  empresas                  empresas                    @relation(fields: [id_empresa], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoria_financeira      categoria_financeira        @relation(fields: [id_categoria], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contas_pagar              contas_pagar?               @relation(fields: [id_conta_pagar], references: [id], onDelete: SetNull, onUpdate: Cascade)
  movimentacoes_financeiras movimentacoes_financeiras[]

  @@index([id_empresa], map: "idx_despesas_empresa")
  @@index([id_categoria], map: "idx_despesas_categoria")
  @@index([id_conta_pagar], map: "idx_despesas_conta_pagar")
  @@index([data_despesa], map: "idx_despesas_data")
}

model empresa_fornecedor {
  id              Int                       @id @default(autoincrement())
  id_empresa      Int
  id_fornecedor   Int
  prazo_pagamento Int?
  prazo_entrega   Int?
  observacao      String?                   @db.VarChar(255)
  status          empresa_fornecedor_status @default(ATIVO)
  empresas        empresas                  @relation(fields: [id_empresa], references: [id], onDelete: Cascade, map: "fk_empresa_fornecedor_empresa")
  fornecedores    fornecedores              @relation(fields: [id_fornecedor], references: [id], map: "fk_empresa_fornecedor_fornecedor")

  @@unique([id_empresa, id_fornecedor], map: "uk_empresa_fornecedor")
  @@index([id_fornecedor], map: "fk_empresa_fornecedor_fornecedor")
}

model empresas {
  id                        Int                         @id @default(autoincrement())
  razao_social              String                      @db.VarChar(150)
  nome_fantasia             String?                     @db.VarChar(150)
  cnpj                      String                      @unique(map: "uk_empresa_cnpj") @db.VarChar(18)
  inscricao_estadual        String?                     @db.VarChar(30)
  email                     String?                     @db.VarChar(150)
  telefone                  String?                     @db.VarChar(30)
  endereco                  String?                     @db.VarChar(255)
  numero                    String?                     @db.VarChar(20)
  complemento               String?                     @db.VarChar(100)
  bairro                    String?                     @db.VarChar(100)
  cidade                    String?                     @db.VarChar(100)
  estado                    String?                     @db.Char(2)
  cep                       String?                     @db.VarChar(10)
  logo_url                  String?                     @db.LongText
  cor_tema                  String                      @default("#22c55e") @db.VarChar(50)
  status                    empresas_status             @default(ATIVA)
  data_cadastro             DateTime                    @default(now()) @db.Timestamp(0)
  auditoria                 auditoria[]
  cargos                    cargos[]
  categorias                categorias[]
  clientes                  clientes[]
  compras                   compras[]
  cores                     cores[]
  empresa_fornecedor        empresa_fornecedor[]
  estoque                   estoque[]
  ficha_tecnica             ficha_tecnica[]
  fornecedores              fornecedores[]
  kardex                    kardex[]
  locais_estoque            locais_estoque[]
  movimentacao_estoque      movimentacao_estoque[]
  nota_fiscal               nota_fiscal[]
  ordem_producao            ordem_producao[]
  pedido_compra             pedido_compra[]
  produto_empresa           produto_empresa[]
  produto_fornecedor        produto_fornecedor[]
  produto_variacoes         produto_variacoes[]
  requisicao_compra         requisicao_compra[]
  reserva_estoque           reserva_estoque[]
  sequencias_automaticas    sequencias_automaticas[]
  setores                   setores[]
  tamanhos                  tamanhos[]
  tipos_setor               tipos_setor[]
  usuario_empresa           usuario_empresa[]
  venda                     venda[]
  condicoes_pagamento       condicoes_pagamento[]
  categoria_financeira      categoria_financeira[]
  contas_receber            contas_receber[]
  pagamentos_receber        pagamentos_receber[]
  contas_pagar              contas_pagar[]
  pagamentos_pagar          pagamentos_pagar[]
  despesas                  despesas[]
  contas_bancarias          contas_bancarias[]
  movimentacoes_financeiras movimentacoes_financeiras[]
  pedido_cliente            pedido_cliente[]
}

model estoque {
  id                   Int            @id @default(autoincrement())
  id_empresa           Int
  id_local_estoque     Int
  id_setor             Int
  id_produto           Int
  quantidade           Decimal        @default(0.000) @db.Decimal(15, 3)
  quantidade_reservada Decimal        @default(0.000) @db.Decimal(15, 3)
  data_atualizacao     DateTime       @default(now()) @db.Timestamp(0)
  empresas             empresas       @relation(fields: [id_empresa], references: [id], onDelete: Cascade, map: "fk_estoque_empresa")
  locais_estoque       locais_estoque @relation(fields: [id_local_estoque], references: [id], map: "fk_estoque_local")
  produtos             produtos       @relation(fields: [id_produto], references: [id], map: "fk_estoque_produto")
  setores              setores        @relation(fields: [id_setor], references: [id], map: "fk_estoque_setor")

  @@unique([id_empresa, id_local_estoque, id_produto], map: "uk_estoque_empresa_local_produto")
  @@unique([id_empresa, id_setor, id_produto], map: "uk_estoque_empresa_setor_produto")
  @@index([id_local_estoque], map: "fk_estoque_local")
  @@index([id_produto], map: "fk_estoque_produto")
  @@index([id_setor], map: "fk_estoque_setor")
}

model ficha_tecnica {
  id                 Int                  @id @default(autoincrement())
  id_empresa         Int
  id_produto         Int
  versao             Int                  @default(1)
  status             ficha_tecnica_status @default(RASCUNHO)
  data_vigencia      DateTime?            @db.Date
  empresas           empresas             @relation(fields: [id_empresa], references: [id], onDelete: Cascade, map: "fk_ficha_empresa")
  produtos           produtos             @relation(fields: [id_produto], references: [id], map: "fk_ficha_produto")
  ficha_tecnica_item ficha_tecnica_item[]

  @@unique([id_empresa, id_produto, versao], map: "uk_ficha_produto_versao")
  @@index([id_produto], map: "fk_ficha_produto")
}

model ficha_tecnica_item {
  id                    Int           @id @default(autoincrement())
  id_ficha_tecnica      Int
  id_produto_componente Int
  quantidade            Decimal       @db.Decimal(15, 3)
  perda_percentual      Decimal       @default(0.00) @db.Decimal(5, 2)
  produtos              produtos      @relation(fields: [id_produto_componente], references: [id], map: "fk_ficha_item_componente")
  ficha_tecnica         ficha_tecnica @relation(fields: [id_ficha_tecnica], references: [id], onDelete: Cascade, map: "fk_ficha_item_ficha")

  @@unique([id_ficha_tecnica, id_produto_componente], map: "uk_ficha_item_componente")
  @@index([id_produto_componente], map: "fk_ficha_item_componente")
}

model fornecedores {
  id                 Int                  @id @default(autoincrement())
  id_empresa         Int?
  razao_social       String               @db.VarChar(150)
  nome_fantasia      String?              @db.VarChar(150)
  cnpj               String?              @db.VarChar(18)
  inscricao_estadual String?              @db.VarChar(30)
  email              String?              @db.VarChar(150)
  telefone           String?              @db.VarChar(30)
  endereco           String?              @db.VarChar(255)
  numero             String?              @db.VarChar(20)
  complemento        String?              @db.VarChar(100)
  bairro             String?              @db.VarChar(100)
  cidade             String?              @db.VarChar(100)
  estado             String?              @db.Char(2)
  cep                String?              @db.VarChar(10)
  status             fornecedores_status  @default(ATIVO)
  data_cadastro      DateTime             @default(now()) @db.Timestamp(0)
  compras            compras[]
  empresa_fornecedor empresa_fornecedor[]
  empresas           empresas?            @relation(fields: [id_empresa], references: [id], onDelete: Cascade, map: "fk_fornecedores_empresa")
  nota_fiscal        nota_fiscal[]
  pedido_compra      pedido_compra[]
  produto_fornecedor produto_fornecedor[]

  @@unique([id_empresa, cnpj], map: "uk_fornecedor_empresa_cnpj")
}

model item_nota_fiscal {
  id                                 Int                         @id @default(autoincrement())
  id_nota_fiscal                     Int
  numero_item                        Int
  id_produto                         Int?
  id_cor                             Int?
  id_tamanho                         Int?
  codigo_produto                     String?                     @db.VarChar(100)
  descricao_produto                  String?                     @db.VarChar(255)
  quantidade                         Decimal                     @db.Decimal(15, 3)
  unidade                            String                      @db.VarChar(20)
  tipo_valor                         item_nota_fiscal_tipo_valor @default(UNITARIO)
  valor_unitario                     Decimal                     @db.Decimal(15, 2)
  valor_total                        Decimal                     @db.Decimal(15, 2)
  produto_cadastrado_automaticamente Boolean                     @default(false)
  cores                              cores?                      @relation(fields: [id_cor], references: [id], onDelete: Restrict, map: "fk_item_nf_cor")
  nota_fiscal                        nota_fiscal                 @relation(fields: [id_nota_fiscal], references: [id], onDelete: Cascade, map: "fk_item_nf_nota")
  produtos                           produtos?                   @relation(fields: [id_produto], references: [id], onDelete: Restrict, map: "fk_item_nf_produto")
  tamanhos                           tamanhos?                   @relation(fields: [id_tamanho], references: [id], onDelete: Restrict, map: "fk_item_nf_tamanho")

  @@unique([id_nota_fiscal, numero_item], map: "uk_item_nf")
  @@index([id_cor], map: "fk_item_nf_cor")
  @@index([id_produto], map: "fk_item_nf_produto")
  @@index([id_tamanho], map: "fk_item_nf_tamanho")
}

model item_pedido_compra {
  id               Int           @id @default(autoincrement())
  id_pedido_compra Int
  id_produto       Int
  quantidade       Decimal       @db.Decimal(15, 3)
  valor_unitario   Decimal       @db.Decimal(15, 2)
  valor_total      Decimal       @db.Decimal(15, 2)
  pedido_compra    pedido_compra @relation(fields: [id_pedido_compra], references: [id], onDelete: Cascade, map: "fk_item_pedido_compra_pedido")
  produtos         produtos      @relation(fields: [id_produto], references: [id], map: "fk_item_pedido_compra_produto")

  @@index([id_pedido_compra], map: "fk_item_pedido_compra_pedido")
  @@index([id_produto], map: "fk_item_pedido_compra_produto")
}

model item_requisicao_compra {
  id                   Int               @id @default(autoincrement())
  id_requisicao_compra Int
  id_produto           Int
  quantidade           Decimal           @db.Decimal(15, 3)
  observacao           String?           @db.VarChar(255)
  produtos             produtos          @relation(fields: [id_produto], references: [id], map: "fk_item_req_compra_produto")
  requisicao_compra    requisicao_compra @relation(fields: [id_requisicao_compra], references: [id], onDelete: Cascade, map: "fk_item_req_compra_requisicao")

  @@unique([id_requisicao_compra, id_produto], map: "uk_item_req_compra_produto")
  @@index([id_produto], map: "fk_item_req_compra_produto")
}

model item_venda {
  id                     Int      @id @default(autoincrement())
  id_pedido_cliente_item Int?
  id_venda               Int
  id_produto             Int
  quantidade             Decimal  @db.Decimal(15, 3)
  valor_unitario         Decimal  @db.Decimal(15, 2)
  valor_total            Decimal  @db.Decimal(15, 2)
  produtos               produtos @relation(fields: [id_produto], references: [id], map: "fk_item_venda_produto")
  venda                  venda    @relation(fields: [id_venda], references: [id], onDelete: Cascade, map: "fk_item_venda_venda")

  pedido_cliente_item pedido_cliente_item? @relation(fields: [id_pedido_cliente_item], references: [id], onDelete: Restrict, map: "fk_item_venda_pedido_item")

  @@unique([id_venda, id_produto], map: "uk_item_venda_produto")
  @@index([id_produto], map: "fk_item_venda_produto")
  @@index([id_pedido_cliente_item], map: "fk_item_venda_pedido_item")
}

model kardex {
  id                   Int                      @id @default(autoincrement())
  id_empresa           Int
  id_local_estoque     Int?
  id_setor             Int?
  id_produto           Int
  id_movimentacao      Int                      @unique(map: "uk_kardex_movimentacao")
  tipo_movimentacao    kardex_tipo_movimentacao
  quantidade           Decimal                  @db.Decimal(15, 3)
  saldo_anterior       Decimal                  @db.Decimal(15, 3)
  saldo_atual          Decimal                  @db.Decimal(15, 3)
  data_movimentacao    DateTime                 @default(now()) @db.Timestamp(0)
  empresas             empresas                 @relation(fields: [id_empresa], references: [id], map: "fk_kardex_empresa")
  locais_estoque       locais_estoque?          @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict, map: "fk_kardex_local")
  movimentacao_estoque movimentacao_estoque     @relation(fields: [id_movimentacao], references: [id], map: "fk_kardex_movimentacao")
  produtos             produtos                 @relation(fields: [id_produto], references: [id], map: "fk_kardex_produto")
  setores              setores?                 @relation(fields: [id_setor], references: [id], onDelete: Restrict, map: "fk_kardex_setor")

  @@index([id_empresa], map: "fk_kardex_empresa")
  @@index([id_local_estoque], map: "fk_kardex_local")
  @@index([id_produto], map: "fk_kardex_produto")
  @@index([id_setor], map: "fk_kardex_setor")
}

model locais_estoque {
  id                   Int                    @id @default(autoincrement())
  id_empresa           Int
  nome                 String                 @db.VarChar(100)
  descricao            String?                @db.VarChar(255)
  status               locais_estoque_status  @default(ATIVO)
  compras              compras[]
  estoque              estoque[]
  kardex               kardex[]
