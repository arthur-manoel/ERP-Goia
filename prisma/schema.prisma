model venda {
  id                        Int                         @id @default(autoincrement())
  id_pedido_cliente         Int?
  id_empresa                Int
  id_cliente                Int
  id_usuario                Int
  numero                    String                      @db.VarChar(50)
  status                    venda_status                @default(RASCUNHO)
  data_venda                DateTime                    @default(now()) @db.Timestamp(0)
  data_entrega              DateTime?                   @db.DateTime(0)
  valor_total               Decimal                     @default(0.00) @db.Decimal(15, 2)
  entrega_nome_destinatario String?                     @db.VarChar(150)
  entrega_telefone          String?                     @db.VarChar(30)
  entrega_endereco          String?                     @db.VarChar(255)
  entrega_numero            String?                     @db.VarChar(20)
  entrega_complemento       String?                     @db.VarChar(100)
  entrega_bairro            String?                     @db.VarChar(100)
  entrega_cidade            String?                     @db.VarChar(100)
  entrega_estado            String?                     @db.Char(2)
  entrega_cep               String?                     @db.VarChar(10)
  observacao_interna        String?                     @db.Text
  id_condicao_pagamento     Int?
  id_endereco_entrega       Int?
  canal_venda               venda_canal_venda           @default(BALCAO)
  status_financeiro         venda_status_financeiro     @default(NAO_FATURADA)
  valor_subtotal            Decimal                     @default(0) @db.Decimal(15, 2)
  valor_desconto            Decimal                     @default(0) @db.Decimal(15, 2)
  valor_frete               Decimal                     @default(0) @db.Decimal(15, 2)
  valor_acrescimo           Decimal                     @default(0) @db.Decimal(15, 2)
  observacao                String?                     @db.Text
  data_atualizacao          DateTime                    @updatedAt
  item_venda                item_venda[]
  parcelas                  venda_parcelas[]
  historico_status          venda_status_historico[]
  reserva_estoque           reserva_estoque[]
  clientes                  clientes                    @relation("venda_cliente_empresa", fields: [id_empresa, id_cliente], references: [id_empresa, id], map: "fk_venda_cliente_empresa")
  empresas                  empresas                    @relation(fields: [id_empresa], references: [id], map: "fk_venda_empresa")
  usuario_empresa           usuario_empresa             @relation("venda_usuario_empresa", fields: [id_usuario, id_empresa], references: [id_usuario, id_empresa], map: "fk_venda_usuario_empresa")
  condicoes_pagamento       condicoes_pagamento?        @relation(fields: [id_condicao_pagamento], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cliente_endereco          cliente_endereco?           @relation("VendaEnderecoEntrega", fields: [id_endereco_entrega], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contas_receber            contas_receber[]
  pedido_cliente            pedido_cliente?             @relation(fields: [id_pedido_cliente], references: [id], onDelete: Restrict, map: "fk_venda_pedido_cliente")
  pedido_cliente_fechamento pedido_cliente_fechamento[]

  @@unique([id_empresa, numero], map: "uk_venda_empresa_numero")
  @@unique([id_empresa, id], map: "uk_venda_empresa_id")
  @@unique([id, id_empresa, id_cliente, id_pedido_cliente], map: "uk_venda_id_empresa_cliente_pedido")
  @@index([id_empresa, id_cliente], map: "idx_venda_empresa_cliente")
  @@index([id_empresa, id_usuario], map: "idx_venda_empresa_usuario")
  @@index([id_cliente], map: "fk_venda_cliente")
  @@index([id_usuario], map: "fk_venda_usuario")
  @@index([id_condicao_pagamento])
  @@index([id_endereco_entrega])
  @@index([status_financeiro])
  @@index([id_pedido_cliente], map: "fk_venda_pedido_cliente")
}

model venda_parcelas {
  id                   Int                    @id @default(autoincrement())
  id_empresa           Int
  id_venda             Int
  numero_parcela       Int
  valor                Decimal                @db.Decimal(15, 2)
  data_vencimento      DateTime               @db.Date
  valor_pago           Decimal                @default(0.00) @db.Decimal(15, 2)
  data_pagamento       DateTime?              @db.DateTime(0)
  forma_pagamento      venda_forma_pagamento?
