model nota_fiscal {
  id                 Int                @id @default(autoincrement())
  id_empresa         Int
  id_local_estoque   Int?
  id_fornecedor      Int
  id_pedido_compra   Int?
  id_compra          Int?
  id_setor_destino   Int?
  numero             String             @db.VarChar(30)
  serie              String             @db.VarChar(10)
  chave_acesso       String             @unique(map: "uk_nf_chave_acesso") @db.VarChar(44)
  status             nota_fiscal_status @default(PENDENTE)
  data_emissao       DateTime?          @db.DateTime(0)
  data_recebimento   DateTime?          @db.DateTime(0)
  valor_total        Decimal            @default(0.00) @db.Decimal(15, 2)
  entrada_processada Boolean            @default(false)
  data_processamento DateTime?          @db.DateTime(0)
  observacao         String?            @db.VarChar(255)
  item_nota_fiscal   item_nota_fiscal[]
  setores            setores?           @relation(fields: [id_setor_destino], references: [id], onDelete: Restrict, map: "fk_nf_setor_destino")
  compras            compras?           @relation(fields: [id_compra], references: [id], onDelete: Restrict, map: "fk_nota_fiscal_compra")
  empresas           empresas           @relation(fields: [id_empresa], references: [id], map: "fk_nota_fiscal_empresa")
  fornecedores       fornecedores       @relation(fields: [id_fornecedor], references: [id], map: "fk_nota_fiscal_fornecedor")
  locais_estoque     locais_estoque?    @relation(fields: [id_local_estoque], references: [id], onDelete: Restrict, map: "fk_nota_fiscal_local")
  pedido_compra      pedido_compra?     @relation(fields: [id_pedido_compra], references: [id], map: "fk_nota_fiscal_pedido")

  @@unique([id_empresa, numero, serie], map: "uk_nf_empresa_numero_serie")
  @@index([id_setor_destino], map: "fk_nf_setor_destino")
  @@index([id_compra], map: "fk_nota_fiscal_compra")
  @@index([id_fornecedor], map: "fk_nota_fiscal_fornecedor")
  @@index([id_local_estoque], map: "fk_nota_fiscal_local")
  @@index([id_pedido_compra], map: "fk_nota_fiscal_pedido")
}

