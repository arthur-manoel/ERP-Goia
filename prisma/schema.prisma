  id_apontamento_anterior    Int?                             @unique(map: "uk_apontamento_evento_anterior")
  motivo                     String?                          @db.VarChar(255)
  data_cadastro              DateTime                         @default(now())
  apontamento_anterior       ordem_producao_apontamento?      @relation("apontamento_anterior", fields: [id_ordem_producao, id_ordem_producao_item, id_setor, id_apontamento_anterior], references: [id_ordem_producao, id_ordem_producao_item, id_setor, id], onUpdate: Restrict, map: "fk_apontamento_evento_anterior")
  apontamento_novo           ordem_producao_apontamento?      @relation("apontamento_novo", fields: [id_ordem_producao, id_ordem_producao_item, id_setor, id_apontamento_novo], references: [id_ordem_producao, id_ordem_producao_item, id_setor, id], onUpdate: Restrict, map: "fk_apontamento_evento_novo")
  ordem_producao             ordem_producao                   @relation(fields: [id_empresa, id_ordem_producao], references: [id_empresa, id], onUpdate: Restrict, map: "fk_apontamento_evento_ordem")
  ordem_producao_fluxo_setor ordem_producao_fluxo_setor       @relation(fields: [id_ordem_producao, id_etapa, id_setor], references: [id_ordem_producao, id, id_setor], onUpdate: Restrict, map: "fk_apontamento_evento_etapa")
  ordem_producao_item        ordem_producao_item              @relation(fields: [id_ordem_producao, id_ordem_producao_item], references: [id_ordem_producao, id], onUpdate: Restrict, map: "fk_apontamento_evento_item")
  usuario_empresa            usuario_empresa                  @relation(fields: [id_usuario, id_empresa], references: [id_usuario, id_empresa], onUpdate: Restrict, map: "fk_apontamento_evento_usuario_empresa")

  @@unique([id_empresa, chave_idempotencia], map: "uk_apontamento_evento_chave")
  @@index([id_ordem_producao, id_ordem_producao_item, id_setor, id_apontamento_anterior], map: "fk_apontamento_evento_anterior")
  @@index([id_ordem_producao, id_etapa, id_setor], map: "fk_apontamento_evento_etapa")
  @@index([id_ordem_producao, id_ordem_producao_item, id_setor, id_apontamento_novo], map: "fk_apontamento_evento_novo")
  @@index([id_usuario, id_empresa], map: "fk_apontamento_evento_usuario_empresa")
  @@index([id_empresa, id_ordem_producao, data_cadastro], map: "idx_apontamento_evento_historico")
}

enum producao_apontamento_evento_tipo {
  REGISTRO
  CORRECAO
  ESTORNO
}

model producao_confirmacao {
  id                         Int                         @id @default(autoincrement())
  id_empresa                 Int
  id_ordem_producao          Int
  id_ordem_producao_item     Int
  id_setor                   Int?
  id_usuario                 Int
  chave_idempotencia         String                      @db.VarChar(128)
  hash_requisicao            String                      @db.Char(64)
  hash_estado                String                      @db.Char(64)
  tipo                       producao_confirmacao_tipo
  quantidade_produzida       Decimal                     @db.Decimal(15, 3)
  quantidade_esperada        Decimal                     @db.Decimal(15, 3)
  id_apontamento_novo        Int?                        @unique(map: "uk_producao_confirmacao_apontamento")
  data_cadastro              DateTime                    @default(now())
  ordem_producao_apontamento ordem_producao_apontamento? @relation(fields: [id_ordem_producao, id_ordem_producao_item, id_setor, id_apontamento_novo], references: [id_ordem_producao, id_ordem_producao_item, id_setor, id], onUpdate: Restrict, map: "fk_producao_confirmacao_apontamento")
  ordem_producao_item        ordem_producao_item         @relation(fields: [id_ordem_producao, id_ordem_producao_item], references: [id_ordem_producao, id], onUpdate: Restrict, map: "fk_producao_confirmacao_item")
  ordem_producao             ordem_producao              @relation(fields: [id_empresa, id_ordem_producao], references: [id_empresa, id], onUpdate: Restrict, map: "fk_producao_confirmacao_ordem")
  ordem_producao_fluxo_setor ordem_producao_fluxo_setor? @relation(fields: [id_ordem_producao, id_setor], references: [id_ordem_producao, id_setor], onUpdate: Restrict, map: "fk_producao_confirmacao_setor")
  usuario_empresa            usuario_empresa             @relation(fields: [id_usuario, id_empresa], references: [id_usuario, id_empresa], onUpdate: Restrict, map: "fk_producao_confirmacao_usuario")

  @@unique([id_empresa, chave_idempotencia], map: "uk_producao_confirmacao_chave")
  @@index([id_ordem_producao, id_ordem_producao_item, id_setor, id_apontamento_novo], map: "fk_producao_confirmacao_apontamento")
  @@index([id_empresa, id_ordem_producao], map: "fk_producao_confirmacao_ordem")
  @@index([id_ordem_producao, id_setor], map: "fk_producao_confirmacao_setor")
  @@index([id_usuario, id_empresa], map: "fk_producao_confirmacao_usuario")
  @@index([id_ordem_producao, id_ordem_producao_item], map: "idx_producao_confirmacao_item")
}

enum producao_confirmacao_tipo {
  REGISTRO
  CONFIRMACAO
  LEGADO
}
